(footprint "Alps_RK10J1xR_Thumbwheel"
	(version 20240108)
	(generator "eink-pod")
	(layer "F.Cu")
	(descr "Alps RK10J1xR reflow thumbwheel potentiometer, 14 mm knurled knob parallel to the PCB (RK10J11R0A0H, LCSC C470766). Land pattern from EasyEDA, checked against Alps drawing No.2. Terminals 1,2,dummy,dummy,3. Knob centre at (0,-2.4), knob edge at y=-9.4: place the board edge at y=-7.9 so 1.5 mm of knob overhangs.")
	(tags "potentiometer thumbwheel volume RK10J")
	(attr smd)
	(property "Reference" "REF**" (at -4.5 -1 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(property "Value" "10k" (at 0 3 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(fp_circle (center 0 -2.4) (end 7 -2.4) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_line (start -7 -2.4) (end -7 5.6) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 7 -2.4) (end 7 5.6) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -7 5.6) (end 7 5.6) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -7.1 5.7) (end -5 5.7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 5 5.7) (end 7.1 5.7) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -7.1 5.7) (end -7.1 -3.3) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 7.1 5.7) (end 7.1 -3.3) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_circle (center -4 8.1) (end -3.85 8.1) (stroke (width 0.15) (type solid)) (fill solid) (layer "F.SilkS"))
	(fp_rect (start -7.3 -9.7) (end 7.3 7.6) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(pad "1" smd rect (at -4 6.6) (size 1.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd rect (at -2 6.6) (size 1.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "" smd rect (at 0 6.6) (size 1.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "" smd rect (at 2 6.6) (size 1.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "3" smd rect (at 4 6.6) (size 1.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "MP" smd rect (at -6.1 -4.9) (size 2.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "MP" smd rect (at 6.1 -4.9) (size 2.2 1.4) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "MP" thru_hole oval (at 0 -6.6) (size 3 1.6) (drill oval 2.3 1.1) (layers "*.Cu" "*.Mask"))
	(pad "MP" thru_hole oval (at 0 1.8) (size 3 1.6) (drill oval 2.3 1.1) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/3d/Alps_RK10J1xR.wrl"
		(offset (xyz 0 0 0))
		(scale (xyz 0.3937 0.3937 0.3937))
		(rotate (xyz 0 0 0))
	)
)
