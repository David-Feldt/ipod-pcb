CONFIG_IDF_TARGET="esp32s3"

# ESP32-S3-MINI-1-N8: 8 MB quad flash, NO PSRAM (FIRMWARE-NOTES.md)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console and logs on the native USB-Serial/JTAG port (GPIO19/20)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Keep the brownout detector enabled (FIRMWARE-NOTES.md)
CONFIG_ESP_BROWNOUT_DET=y

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# LVGL: native 1-bit rendering for the e-paper, no theme (screens style themselves)
CONFIG_LV_COLOR_DEPTH_1=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# No PSRAM: let idle TLS connections release their record buffers and
# certificate data (one kept-alive API connection + album-art downloads).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# Resume TLS sessions (album-art host): skips the software ECC handshake.
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
# TLS handshakes are CPU-bound (no ECC accelerator): 240 MHz is ~1.5x faster.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Pairing: QR code on the e-paper; the OAuth callback URL carries a long
# authorization code, and phone browsers send long request headers.
CONFIG_LV_USE_QRCODE=y
CONFIG_HTTPD_MAX_URI_LEN=1536
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
